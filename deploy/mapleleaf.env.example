# Copy to /etc/mapleleaf.env on the server and fill in the real values.
# Keep this file root-owned with 600 permissions; never commit the filled copy.

DJANGO_SETTINGS_MODULE=config.settings

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,YOUR_SERVER_IP
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# nginx sets X-Forwarded-For, so the sign-in rate limiter can trust it.
TRUST_X_FORWARDED_FOR=1

# Turn these on after Let's Encrypt HTTPS is working. While obtaining the
# certificate, set DJANGO_SECURE_SSL_REDIRECT=0 and DJANGO_SECURE_COOKIES=0.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=1

# Optional SMTP delivery for callback/booking/photo-request emails.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
